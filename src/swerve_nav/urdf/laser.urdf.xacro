<?xml version="1.0"?>
<!-- ===========================================================================  -->
<!-- |    laser.urdf.xacro  (ROS 2 / gz port)                                    | -->
<!-- |    author: Koji Shibata                                                   | -->
<!-- |    e-mail: kshibata.0519@gmail.com                                        | -->
<!-- |    This is a URDF file that describes an omnidirectional                   | -->
<!-- |    four-wheeled robot for ROS 2 users.                                     | -->
<!-- ===========================================================================  -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
	<xacro:macro name="laser_macro" params="parent prefix xyz rpy">
		<!-- Generic simulation housing: assumed dimensions (m) and mass (kg), not hardware specifications. -->
		<xacro:property name="lidar_length" value="0.05"/>
		<xacro:property name="lidar_width" value="0.05"/>
		<xacro:property name="lidar_height" value="0.07"/>
		<xacro:property name="lidar_mass" value="0.1"/>
		<!-- The link origin is the scan center; the mounting bracket is omitted. -->
		<link name="${prefix}_link">
			<collision>
				<origin xyz="0. 0. 0." rpy="0. 0. 0."/>
				<geometry>
					<box size="${lidar_length} ${lidar_width} ${lidar_height}"/>
				</geometry>
			</collision>
			<visual>
				<origin xyz="0. 0. 0." rpy="0. 0. 0."/>
				<geometry>
					<box size="${lidar_length} ${lidar_width} ${lidar_height}"/>
				</geometry>
				<material name="Gray">
					<color rgba="0.5 0.5 0.5 1."/>
				</material>
			</visual>
			<inertial>
				<mass value="${lidar_mass}"/>
				<origin xyz="0. 0. 0." rpy="0. 0. 0."/>
				<inertia ixx="${lidar_mass * (lidar_width**2 + lidar_height**2) / 12}" ixy="0." ixz="0."
						 iyy="${lidar_mass * (lidar_length**2 + lidar_height**2) / 12}" iyz="0."
						 izz="${lidar_mass * (lidar_length**2 + lidar_width**2) / 12}"/>
			</inertial>
		</link>

		<joint name="${prefix}_joint" type="fixed">
			<origin xyz="${xyz}" rpy="${rpy}"/>
			<parent link="${parent}"/>
			<child link="${prefix}_link"/>
		</joint>

		<!-- gz GPU lidar. Handled by gz-sim-sensors-system and bridged to ROS    -->
		<!-- (sensor_msgs/LaserScan) via ros_gz_bridge.                           -->
		<gazebo reference="${prefix}_link">
			<sensor type="gpu_lidar" name="${prefix}_sensor">
				<pose>0. 0. 0. 0. 0. 0.</pose>
				<always_on>1</always_on>
				<visualize>true</visualize>
				<update_rate>40</update_rate>
				<topic>${prefix}/scan</topic>
				<frame_id>${prefix}_link</frame_id>
				<lidar>
					<scan>
						<horizontal>
							<samples>1080</samples>
							<resolution>1</resolution>
							<min_angle>${-pi}</min_angle>
							<max_angle>${pi}</max_angle>
						</horizontal>
						<vertical>
							<samples>1</samples>
							<resolution>1</resolution>
							<min_angle>0</min_angle>
							<max_angle>0</max_angle>
						</vertical>
					</scan>
					<range>
						<min>0.1</min>
						<max>30.</max>
						<resolution>0.01</resolution>
					</range>
					<noise>
						<type>gaussian</type>
						<mean>0.</mean>
						<stddev>1.e-3</stddev>
					</noise>
				</lidar>
			</sensor>
		</gazebo>
	</xacro:macro>
</robot>
