<?xml version="1.0"?>
<!-- ===========================================================================  -->
<!-- |    laser.urdf.xacro  (ROS 2 / gz port)                                    | -->
<!-- |    author: Koji Shibata                                                   | -->
<!-- |    e-mail: kshibata.0519@gmail.com                                        | -->
<!-- |    This is a URDF file that describes an omnidirectional                   | -->
<!-- |    four-wheeled robot for ROS 2 users.                                     | -->
<!-- ===========================================================================  -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
	<xacro:macro name="laser_macro" params="parent prefix xyz rpy">
		<!-- Physical parameters are centralized in robot.urdf.xacro. The origin is the scan center. -->
		<link name="${prefix}_link">
			<collision>
				<origin xyz="0. 0. 0." rpy="0. 0. 0."/>
				<geometry>
					<box size="${lidar_length} ${lidar_width} ${lidar_height}"/>
				</geometry>
			</collision>
			<visual>
				<origin xyz="0. 0. 0." rpy="0. 0. 0."/>
				<geometry>
					<box size="${lidar_length} ${lidar_width} ${lidar_height}"/>
				</geometry>
				<material name="Gray">
					<color rgba="0.5 0.5 0.5 1."/>
				</material>
			</visual>
			<visual>
				<origin xyz="0 0 0"/>
				<geometry><box size="${lidar_length + 0.001} ${lidar_width + 0.001} 0.02"/></geometry>
				<material name="LidarWindow"><color rgba="0.08 0.10 0.12 1"/></material>
			</visual>
			<inertial>
				<mass value="${lidar_mass}"/>
				<origin xyz="0. 0. 0." rpy="0. 0. 0."/>
				<inertia ixx="${lidar_mass * (lidar_width**2 + lidar_height**2) / 12}" ixy="0." ixz="0."
						 iyy="${lidar_mass * (lidar_length**2 + lidar_height**2) / 12}" iyz="0."
						 izz="${lidar_mass * (lidar_length**2 + lidar_width**2) / 12}"/>
			</inertial>
		</link>

		<joint name="${prefix}_joint" type="fixed">
			<origin xyz="${xyz}" rpy="${rpy}"/>
			<parent link="${parent}"/>
			<child link="${prefix}_link"/>
		</joint>

		<!-- A fixed pedestal fills the gap from the chassis roof to the sensor housing. -->
		<link name="${prefix}_mount_link">
			<visual>
				<geometry><cylinder radius="${lidar_mount_radius}" length="${lidar_mount_height}"/></geometry>
				<material name="LidarMount"><color rgba="0.25 0.30 0.35 1"/></material>
			</visual>
			<collision>
				<geometry><cylinder radius="${lidar_mount_radius}" length="${lidar_mount_height}"/></geometry>
			</collision>
			<inertial>
				<mass value="${lidar_mount_mass}"/>
				<inertia ixx="${lidar_mount_mass * (3*lidar_mount_radius**2 + lidar_mount_height**2)/12}"
					iyy="${lidar_mount_mass * (3*lidar_mount_radius**2 + lidar_mount_height**2)/12}"
					izz="${lidar_mount_mass * lidar_mount_radius**2/2}" ixy="0" ixz="0" iyz="0"/>
			</inertial>
		</link>
		<joint name="${prefix}_mount_joint" type="fixed">
			<parent link="${prefix}_link"/>
			<child link="${prefix}_mount_link"/>
			<origin xyz="0 0 ${-lidar_height/2 - lidar_mount_height/2}"/>
		</joint>

		<!-- gz GPU lidar. Handled by gz-sim-sensors-system and bridged to ROS    -->
		<!-- (sensor_msgs/LaserScan) via ros_gz_bridge.                           -->
		<gazebo reference="${prefix}_link">
			<sensor type="gpu_lidar" name="${prefix}_sensor">
				<pose>0. 0. 0. 0. 0. 0.</pose>
				<always_on>1</always_on>
				<visualize>true</visualize>
				<update_rate>40</update_rate>
				<topic>${prefix}/scan</topic>
				<frame_id>${prefix}_link</frame_id>
				<lidar>
					<scan>
						<horizontal>
							<samples>1080</samples>
							<resolution>1</resolution>
							<min_angle>${-pi}</min_angle>
							<max_angle>${pi}</max_angle>
						</horizontal>
						<vertical>
							<samples>1</samples>
							<resolution>1</resolution>
							<min_angle>0</min_angle>
							<max_angle>0</max_angle>
						</vertical>
					</scan>
					<range>
						<min>0.1</min>
						<max>30.</max>
						<resolution>0.01</resolution>
					</range>
					<noise>
						<type>gaussian</type>
						<mean>0.</mean>
						<stddev>1.e-3</stddev>
					</noise>
				</lidar>
			</sensor>
		</gazebo>
	</xacro:macro>
</robot>
