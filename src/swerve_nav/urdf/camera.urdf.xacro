<?xml version="1.0"?>
<!-- ===========================================================================  -->
<!-- |    camera.urdf.xacro  (ROS 2 / gz port)                                   | -->
<!-- |    author: Koji Shibata                                                   | -->
<!-- |    e-mail: kshibata.0519@gmail.com                                        | -->
<!-- |    This is a URDF file that describes an omnidirectional                   | -->
<!-- |    four-wheeled robot for ROS 2 users.                                     | -->
<!-- ===========================================================================  -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="camera_macro" params="parent prefix xyz">
	<!-- camera_link is at the front imaging plane; the housing extends backward along -X. -->
	<link name="${prefix}_link">
	  <visual>
		<origin xyz="${-camera_depth/2} 0 0"/>
		<geometry><box size="${camera_depth} ${camera_width} ${camera_height}"/></geometry>
		<material name="CameraHousing"><color rgba="0.15 0.18 0.22 1"/></material>
	  </visual>
	  <visual>
		<origin xyz="0.0005 0 0" rpy="0 ${pi/2} 0"/>
		<geometry><cylinder radius="0.007" length="0.001"/></geometry>
		<material name="CameraLens"><color rgba="0.1 0.35 0.7 1"/></material>
	  </visual>
	  <collision>
		<origin xyz="${-camera_depth/2} 0 0"/>
		<geometry><box size="${camera_depth} ${camera_width} ${camera_height}"/></geometry>
	  </collision>
	  <inertial>
		<origin xyz="${-camera_depth/2} 0 0"/>
		<mass value="${camera_mass}"/>
		<inertia ixx="${camera_mass * (camera_width**2 + camera_height**2)/12}"
			iyy="${camera_mass * (camera_depth**2 + camera_height**2)/12}"
			izz="${camera_mass * (camera_depth**2 + camera_width**2)/12}" ixy="0" ixz="0" iyz="0"/>
	  </inertial>
	</link>

	<joint name="${prefix}_joint" type="fixed">
	  <parent link="${parent}"/>
	  <child  link="${prefix}_link"/>
	  <origin xyz="${xyz}" rpy="0 0 0"/>
	</joint>

	<!-- ROS optical axes: Z forward, X right, Y down. -->
	<link name="${prefix}_optical_frame"/>
	<joint name="${prefix}_optical_joint" type="fixed">
	  <parent link="${prefix}_link"/>
	  <child link="${prefix}_optical_frame"/>
	  <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
	</joint>

	<!-- gz camera sensor. Handled by gz-sim-sensors-system (loaded in the    -->
	<!-- world) and bridged to ROS via ros_gz_bridge (see config/gz_bridge.yaml). -->
	<!-- Gazebo renders along camera_link +X; messages use the optical frame. -->
	<gazebo reference="${prefix}_link">
	  <sensor type="camera" name="${prefix}">
		<always_on>1</always_on>
		<update_rate>30</update_rate>
		<visualize>true</visualize>
		<topic>${prefix}/image</topic>
		<frame_id>${prefix}_optical_frame</frame_id>
		<camera name="${prefix}">
		  <horizontal_fov>1.3962634</horizontal_fov>
		  <image>
			<width>800</width>
			<height>600</height>
			<format>R8G8B8</format>
		  </image>
		  <clip>
			<near>0.02</near>
			<far>300</far>
		  </clip>
		  <noise>
			<type>gaussian</type>
			<mean>0.</mean>
			<stddev>0.007</stddev>
		  </noise>
		</camera>
	  </sensor>
	</gazebo>
  </xacro:macro>
</robot>
